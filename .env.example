# Copy to .env and adjust. Without a .env the app uses a local SQLite file.
DATABASE_URL=sqlite:///./onboarding.db
# DATABASE_URL=postgresql+psycopg://onboarding:onboarding@localhost:5432/onboarding
MAX_UPLOAD_BYTES=5242880

# Optional: AI-assisted column mapping. Leave ANTHROPIC_API_KEY unset to skip it.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
