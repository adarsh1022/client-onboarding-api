# Copy to .env and adjust. Without a .env the app uses a local SQLite file.
DATABASE_URL=sqlite:///./onboarding.db
# DATABASE_URL=postgresql+psycopg://onboarding:onboarding@localhost:5432/onboarding
MAX_UPLOAD_BYTES=5242880

# Who suggests mappings for column headers the built-in aliases don't know:
#   heuristic (default): free, offline rules, no setup
#   ollama:              a local open model via Ollama, free (needs `ollama serve` running)
#   claude:              Claude via the Anthropic API, paid (needs ANTHROPIC_API_KEY)
# SUGGESTER=heuristic

# SUGGESTER=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT_SECONDS=60
# OLLAMA_MAX_RETRIES=2

# SUGGESTER=claude
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_RETRIES=2
